# Copy this file to .env.local and fill it in. .env.local is gitignored.
# ⚠️ VITE_ variables end up in the browser bundle. Run this app ONLY on your laptop
#    until EP01 Reel 13 moves the key to a backend. Never deploy it like this.

# Provider (any OpenAI-compatible API). Leave BASE_URL empty for OpenAI.
VITE_AI_BASE_URL=
VITE_AI_API_KEY=your-key-here
VITE_AI_MODEL=model-name-here
